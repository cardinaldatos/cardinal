---
import { readFile } from "node:fs/promises";
import path from "node:path";
import Base from "../layouts/Base.astro";
import RemesasCostoLatam from "../components/RemesasCostoLatam.jsx";

// data/ vive en la raíz del repo, un nivel por encima de sitio/. Esto se
// lee en el servidor durante `astro build` (código de Node en el
// frontmatter), no en el navegador — así que no importa que esté fuera
// de src/. Es el mismo limpio.json que genera pipeline/remesas.py y que
// usan las imágenes de Instagram: un solo origen de verdad para las tres
// superficies.
const rutaDatos = path.join(process.cwd(), "..", "data", "remesas-costo-latam", "limpio.json");
const datos = JSON.parse(await readFile(rutaDatos, "utf-8"));

// La descripción llevaba «diez países», «los tres» y «2023» escritos a
// mano. Es el texto que va al <meta> y el que verá quien comparta el
// enlace, así que era la cifra publicada que menos posibilidades tenía de
// que alguien la recalculara. Ahora sale de los mismos datos que la pieza.
const conDato = datos.con_dato.length;
const sinDato = datos.sin_dato.length;
const anioSerie = datos.anio ?? datos.con_dato[0].anio;
const monto = datos.monto_referencia_usd;
---

<Base
  titulo="Cuánto se queda en el camino"
  descripcion={`Lo que cuesta enviar ${monto} dólares a ${conDato} países de América Latina, y los ${sinDato} que no aparecen en la estadística. Banco Mundial, ${anioSerie}.`}
>
  <RemesasCostoLatam client:load datos={datos} />
</Base>
