---
import { readFile } from "node:fs/promises";
import path from "node:path";
import Base from "../layouts/Base.astro";
import TituloNoCruza from "../components/TituloNoCruza.jsx";

// data/ vive en la raíz del repo, un nivel por encima de sitio/. Esto se
// lee en el servidor durante `astro build` (código de Node en el
// frontmatter), no en el navegador — así que no importa que esté fuera
// de src/. Es el mismo limpio.json que genera pipeline/sobrecualificacion.py.
//
// Hasta hoy esta pieza llevaba las cifras escritas dentro del componente.
// Ahora sigue el mismo patrón que remesas: un solo origen, y la pieza se
// reconstruye desde la fuente en cada compilación.
const rutaDatos = path.join(process.cwd(), "..", "data", "sobrecualificacion-ue", "limpio.json");
const datos = JSON.parse(await readFile(rutaDatos, "utf-8"));

const extraUE = datos.grupos.find((g) => g.id === "NEU27_2020_FOR");
const redondeada = extraUE ? Math.round(extraUE.v2024) : null;
---

<Base
  titulo="El título no cruza"
  descripcion={`${redondeada} de cada 100 migrantes de fuera de la UE con título universitario trabajan por debajo de su formación. Datos de Eurostat, ${datos.anios[datos.anios.length - 1]}.`}
>
  <TituloNoCruza client:load datos={datos} />
</Base>

<style is:global>
  /* Estilos propios de esta pieza. Lo que se repita en una segunda pieza
     se promociona a sistema.css; hasta entonces vive aquí.
     is:global porque el HTML lo genera la isla de React y los estilos
     con ámbito de Astro no lo alcanzan. */

  .tarjeta {
    background: var(--fondo);
    border: 1px solid var(--linea);
    padding: 22px 20px 20px;
  }

  .lectura {
    font-size: 15px;
    line-height: 1.4;
    margin: 0 0 16px;
    max-width: 44ch;
  }

  .lectura .dato-central {
    margin-bottom: 6px;
  }

  /* Barras de comparación: dos rellenos superpuestos. El tenue detrás
     (el año antiguo, o la tasa de los nacionales), el acento delante y
     más fino. */
  .decada {
    margin-bottom: 16px;
  }

  .decada .pista {
    height: 22px;
  }

  .relleno.tenue {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--linea);
  }

  .relleno.encima {
    position: absolute;
    left: 0;
    top: 5px;
    height: 12px;
  }

  .barra-pie {
    font-size: 11px;
    color: var(--pizarra);
    margin: 4px 0 0;
  }

  /* Las filas por país usan la misma superposición que la década, así
     que necesitan la pista alta. */
  .bloque .barra-fila .pista {
    height: 22px;
  }

  .bloque .barra-fila {
    margin-bottom: 14px;
  }

  .caso {
    border-top: 1px solid var(--linea);
    padding: 13px 0;
    display: grid;
    gap: 3px;
  }

  .caso strong {
    font-family: var(--fuente-titular);
    font-weight: 700;
    font-size: 14px;
  }

  .caso span {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--texto-2);
  }
</style>
