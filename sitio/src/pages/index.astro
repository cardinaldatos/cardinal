---
import Base from "../layouts/Base.astro";
import { piezasPorFecha } from "../datos/piezas.js";

// La lista de piezas no vive aquí: está en src/datos/piezas.js, el mismo
// archivo que leen el feed RSS y la página de método. Añadir una pieza
// allí la hace aparecer en las tres a la vez.
//
// El pie institucional tampoco vive aquí: es fijo para todo el sitio y
// está en layouts/Base.astro, junto a la cabecera.
const PIEZAS = piezasPorFecha();
---

<Base titulo={null}>
  <div class="pieza" data-fondo="oscuro">
    <div class="marco">
      <p class="cejilla">Cardinal Datos</p>

      <h1 class="titular">
        Datos que no se<br /><em>traducen solos</em>
      </h1>

      <p class="bajada">
        Recogemos estadísticas públicas sobre migración y diáspora que existen,
        pero casi nadie puede leer. Las volvemos comprensibles, en español.
      </p>

      <div class="bloque">
        <h2>Piezas</h2>
        <p class="intro">
          Cada pieza declara su fuente, su año y su método. Si un dato no se
          puede rastrear hasta un archivo público, no se publica.
        </p>

        {
          PIEZAS.map((p) => (
            <article class="entrada">
              <p class="cejilla origen">
                {p.fuente} · {p.anio}
              </p>
              <h3>
                <a href={`/${p.slug}/`}>{p.titulo}</a>
              </h3>
              <p class="resumen">{p.resumen}</p>
            </article>
          ))
        }
      </div>

      <div class="bloque">
        <h2>Sigue las piezas nuevas</h2>
        <p class="intro">
          Publicamos despacio. Suscríbete al feed y te llegan sin depender de
          ningún algoritmo.
        </p>
        <p class="enlaces">
          <a href="/rss.xml">Feed RSS</a>
          <span class="sep">·</span>
          <a href="/metodo/">Cómo trabajamos</a>
          <span class="sep">·</span>
          <a
            href="https://www.instagram.com/cardinaldatos"
            target="_blank"
            rel="noopener">Instagram ↗</a
          >
        </p>
      </div>

    </div>
  </div>
</Base>

<style>
  .entrada {
    border-top: 1px solid var(--linea);
    padding: 18px 0 6px;
  }

  .origen {
    margin-bottom: 8px;
  }

  .entrada h3 {
    font-family: var(--fuente-titular);
    font-weight: 700;
    font-size: 17px;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .entrada h3 a {
    color: inherit;
    text-decoration-color: var(--pizarra);
    text-underline-offset: 4px;
  }

  .entrada h3 a:hover {
    text-decoration-color: var(--rojo);
  }

  .resumen {
    font-size: 13px;
    line-height: 1.6;
    color: var(--texto-2);
    margin: 0;
    max-width: 48ch;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    font-family: var(--fuente-cifra);
    font-size: 12.5px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--linea);
  }

  .enlaces a {
    color: var(--texto-2);
    text-decoration-color: var(--pizarra);
    text-underline-offset: 4px;
  }

  .enlaces a:hover {
    color: var(--rojo);
    text-decoration-color: var(--rojo);
  }

  .sep {
    color: var(--pizarra);
  }

</style>
