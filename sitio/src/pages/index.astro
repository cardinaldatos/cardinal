---
import { readFile } from "node:fs/promises";
import path from "node:path";
import Base from "../layouts/Base.astro";
import { piezasPorFecha } from "../datos/piezas.js";

// La lista de piezas ya no vive aquí: está en src/datos/piezas.js, que es
// el mismo archivo que leen el feed RSS y la página de método. Añadir una
// pieza allí la hace aparecer en las tres a la vez.
const PIEZAS = piezasPorFecha();

// El pie tampoco tiene su propia lista de fuentes. Antes nombraba cinco
// organismos escritos a mano, dos de los cuales no sostenían ninguna
// pieza: prometía cobertura que no existía y, a la vez, daba la lista por
// cerrada. Ahora lee data/fuentes.json, el mismo registro que sondea
// pipeline/verificar.py y que publica /metodo/.
const CARPETA_DATOS = path.join(process.cwd(), "..", "data");

let fuentes = [];
try {
  const registro = JSON.parse(
    await readFile(path.join(CARPETA_DATOS, "fuentes.json"), "utf-8")
  );
  fuentes = registro.fuentes ?? [];
} catch {
  fuentes = [];
}

const enUso = fuentes.filter((f) => f.estado === "en uso");
const abiertas = fuentes.filter((f) => f.estado !== "en uso");
---

<Base titulo={null}>
  <div class="pieza" data-fondo="oscuro">
    <div class="marco">
      <p class="cejilla">Cardinal Datos</p>

      <h1 class="titular">
        Datos que no se<br /><em>traducen solos</em>
      </h1>

      <p class="bajada">
        Recogemos estadísticas públicas sobre migración y diáspora que existen,
        pero casi nadie puede leer. Las volvemos comprensibles, en español.
      </p>

      <div class="bloque">
        <h2>Piezas</h2>
        <p class="intro">
          Cada pieza declara su fuente, su año y su método. Si un dato no se
          puede rastrear hasta un archivo público, no se publica.
        </p>

        {
          PIEZAS.map((p) => (
            <article class="entrada">
              <p class="cejilla origen">
                {p.fuente} · {p.anio}
              </p>
              <h3>
                <a href={`/${p.slug}/`}>{p.titulo}</a>
              </h3>
              <p class="resumen">{p.resumen}</p>
            </article>
          ))
        }
      </div>

      <div class="bloque">
        <h2>Sigue las piezas nuevas</h2>
        <p class="intro">
          Publicamos despacio. Suscríbete al feed y te llegan sin depender de
          ningún algoritmo.
        </p>
        <p class="enlaces">
          <a href="/rss.xml">Feed RSS</a>
          <span class="sep">·</span>
          <a href="/metodo/">Cómo trabajamos</a>
          <span class="sep">·</span>
          <a
            href="https://www.instagram.com/cardinaldatos"
            target="_blank"
            rel="noopener">Instagram ↗</a
          >
        </p>
      </div>

      <div class="pie">
        <b>Cardinal Datos.</b> Proyecto colectivo. Publicamos cifras sobre
        migración y diáspora que existen en fuentes públicas pero casi nunca
        en español.
        <br /><br />
        Las piezas de hoy se apoyan en{" "}
        {
          enUso.map((f, i) => (
            <>
              {i > 0 && (i === enUso.length - 1 ? " y " : ", ")}
              <a href={f.enlace} target="_blank" rel="noopener">
                {f.nombre}
              </a>
            </>
          ))
        }. El registro completo tiene {fuentes.length} fuentes, ordenadas por
        lo que aporta cada una: series <b>globales</b> que miden todos los
        países con la misma vara, series <b>regionales</b> que comparan entre
        pares, registros de los países <b>de destino</b> donde vive la
        diáspora, y lo que publica el país <b>de origen</b> sobre su propia
        gente fuera. Las {abiertas.length} que aún no hemos abierto están
        listadas igual: el trabajo pendiente también se declara.
        <br /><br />
        Los datos originales pertenecen a sus organismos y conservan su
        licencia. El <a href="/metodo/">método y el registro completo</a> son
        públicos.
      </div>
    </div>
  </div>
</Base>

<style>
  .entrada {
    border-top: 1px solid var(--linea);
    padding: 18px 0 6px;
  }

  .origen {
    margin-bottom: 8px;
  }

  .entrada h3 {
    font-family: var(--fuente-titular);
    font-weight: 700;
    font-size: 17px;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .entrada h3 a {
    color: inherit;
    text-decoration-color: var(--pizarra);
    text-underline-offset: 4px;
  }

  .entrada h3 a:hover {
    text-decoration-color: var(--rojo);
  }

  .resumen {
    font-size: 13px;
    line-height: 1.6;
    color: var(--texto-2);
    margin: 0;
    max-width: 48ch;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    font-family: var(--fuente-cifra);
    font-size: 12.5px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--linea);
  }

  .enlaces a {
    color: var(--texto-2);
    text-decoration-color: var(--pizarra);
    text-underline-offset: 4px;
  }

  .enlaces a:hover {
    color: var(--rojo);
    text-decoration-color: var(--rojo);
  }

  .sep {
    color: var(--pizarra);
  }

  .pie a {
    color: var(--texto-2);
    text-decoration-color: var(--pizarra);
    text-underline-offset: 3px;
  }

  .pie a:hover {
    color: var(--rojo);
  }
</style>
